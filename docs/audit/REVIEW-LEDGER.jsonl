//
// FORMA (uma linha por PR, JSON):
//   {"pr":<int>,"commit":"<sha>","implementer":"<quem escreveu>","verdict":"<lista fechada>",
//    "reviewer":"<quem revisou|omitir>","artifact":"<caminho que existe|omitir>","note":"<por quê>"}
//

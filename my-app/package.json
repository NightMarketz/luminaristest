{
  "name": "luminaris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:gate": "eslint . --config eslint.gate.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.vitest.json --noEmit",
    "check:arch": "depcruise pages features components lib types --config .dependency-cruiser.cjs --ignore-known .dependency-cruiser-known-violations.json --output-type err",
    "check:arch:baseline": "depcruise pages features components lib types --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "check:dead": "knip --no-exit-code",
    "check:dup": "jscpd pages features components lib types --config .jscpd.json --exitCode 0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.18",
    "@fullcalendar/timegrid": "^6.1.22",
    "@heroicons/react": "^2.2.0",
    "@types/react-grid-layout": "^1.3.5",
    "cookies-next": "^5.1.0",
    "cuid": "^3.0.0",
    "i18next": "^26.5.11",
    "next": "15.3.1",
    "next-i18next": "^15.4.2",
    "re-resizable": "^6.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-grid-layout": "^1.5.1",
    "react-i18next": "^15.5.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-select": "^5.10.1",
    "recharts": "^2.15.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "16.10.4",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "jscpd": "4.3.0",
    "jsdom": "^29.1.1",
    "knip": "5.64.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.6"
  }
}

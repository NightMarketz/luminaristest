          "sha256_texto": "f58cdf2e7d483f172a4648aa67b3e40a4cbf29dc5f59eaa0b4d819dc74a7962e"
        },
        "tipo": "TEXTO_MUDOU",
        "citado_em": [
          {
            "slug": "emissao-mei-me-por-tipo",
            "id": "D02"
          }
        ],
        "diferencas": [
          "-§ 1º Relativamente à prestação de serviços sujeita ao ISS, a ME ou EPP optante pelo Simples Nacional utilizará a Nota Fiscal de Serviços, conforme modelo aprovado e autorizado pelo Município, ou Distrito Federal, ou outro documento fiscal ",

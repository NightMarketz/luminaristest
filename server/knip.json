{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/server.ts",
    "src/jobs/*Cli.ts",
    "src/scripts/*.ts",
    "src/routes/docs.paths.ts",
    "prisma/seed.ts",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "prisma/**/*.ts", "scripts/**/*.{js,mjs,ts}"],
  "paths": {
    "@test/*": ["test/*"],
    "@server/*": ["src/*"]
  },
  "ignore": ["generated/**", "dist/**"]
}

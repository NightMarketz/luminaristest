DATABASE_URL=file:./prisma/dev.db
# Obrigatório: o servidor não sobe sem ele (BRD F-03.4). development | test | production
NODE_ENV=development
JWT_SECRET=your-secret-key-minimum-32-characters-change-in-production # minimum 32 characters
JWT_EXPIRES_IN=7d
# Documents are sent to OpenAI for processing. Ensure OpenAI DPA is signed before production use.
# See PRIVACY.md for full compliance notes.
OPENAI_API_KEY=sk-...
# RAG: índice de vetores (sqlite-vec) num arquivo SQLite próprio. Sem a variável, vectors.db ao lado do arquivo do DATABASE_URL.
# VECTOR_DB_PATH=./prisma/vectors.db
PORT=3001
ALLOWED_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-secure-admin-password
# Document upload limits (enforced by multer in documentsController.ts)
# MAX_UPLOAD_SIZE_MB=50  (hard-coded; edit MAX_FILE_SIZE in documentsController.ts to change)
# Fire-and-forget POST when a scheduler job or the process fails, a reconcile run has blocked/failed rows, or a SPED/data-exchange export job fails (see server/src/lib/alertWebhook.ts). Empty/unset = no alert sent.
# REQUIRED in production (docker-compose.yml refuses to start without it; RUNBOOK-M2-DEPLOY-SMOKE.md step 4a). Optional in dev.
ALERT_WEBHOOK_URL=
# Pasta dos binários de anexo/exportação (SPED, exports, anexos). Sem a variável, o padrão é <cwd>/storage/attachments:
# trocar de pasta/worktree com o mesmo banco deixa jobs EXPORTED sem arquivo (o download devolve 404 "não está mais disponível").
# Em runbook de tela e em qualquer ambiente com DATABASE_URL absoluto/compartilhado, defina caminho ABSOLUTO e estável.
# ATTACHMENTS_DIR=C:/caminho/absoluto/storage/attachments

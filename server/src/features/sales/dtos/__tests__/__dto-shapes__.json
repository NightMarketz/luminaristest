{
  "RegisterPaymentDto.ts": {
    "RegisterPaymentSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tableId": {
          "type": "string",
          "minLength": 1
        },
        "saleId": {
          "type": "string",
          "minLength": 1
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "Credit Card",
            "Debit Card",
            "Cash",
            "Pix",
            "Package Balance"
          ]
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "paymentReference": {
          "type": "string",
          "maxLength": 255
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tableId",
        "saleId",
        "paymentMethod"
      ],
      "additionalProperties": false
    }
  },
  "SalesCancellationDto.ts": {
    "CancelSaleSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tableId": {
          "type": "string",
          "minLength": 1
        },
        "saleId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "tableId",
        "saleId"
      ],
      "additionalProperties": false
    },
    "ReturnSaleSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tableId": {
          "type": "string",
          "minLength": 1
        },
        "saleId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "tableId",
        "saleId"
      ],
      "additionalProperties": false
    }
  }
}

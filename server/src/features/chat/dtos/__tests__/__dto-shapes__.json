{
  "ChatDto.ts": {
    "ChatRequestSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 4000
        },
        "documentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "content"
            ]
          }
        },
        "chatInstanceId": {
          "type": "string"
        },
        "confirmedProposalId": {
          "type": "string"
        },
        "ragMode": {
          "type": "string",
          "enum": [
            "DESCRITIVO",
            "RAPIDO"
          ]
        }
      }
    },
    "ChatResponseSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answer": {
          "type": "string"
        },
        "type": {
          "default": "TEXT",
          "type": "string",
          "enum": [
            "TEXT",
            "ACTION_PROPOSAL"
          ]
        },
        "proposal": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "action": {
              "type": "string",
              "enum": [
                "CREATE",
                "UPDATE",
                "DELETE"
              ]
            },
            "tableName": {
              "type": "string"
            },
            "tableLabel": {
              "type": "string"
            },
            "data": {}
          },
          "required": [
            "id",
            "action",
            "tableName",
            "tableLabel",
            "data"
          ]
        },
        "sourceDocuments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "documentId": {
                    "type": "string"
                  },
                  "textContent": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "chunkId": {
                    "type": "string"
                  },
                  "index": {
                    "type": "number"
                  }
                },
                "required": [
                  "documentId",
                  "textContent",
                  "fileName",
                  "chunkId",
                  "index"
                ]
              },
              "technical": {
                "type": "object",
                "properties": {
                  "chunkId": {
                    "type": "string"
                  },
                  "documentId": {
                    "type": "string"
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "chunkIndex": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "score": {
                    "type": "number"
                  },
                  "embeddingStamp": {
                    "type": "string"
                  }
                },
                "required": [
                  "chunkId",
                  "documentId",
                  "fileName",
                  "chunkIndex",
                  "score",
                  "embeddingStamp"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "score",
              "payload"
            ]
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "marker": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "chunkId": {
                "type": "string"
              }
            },
            "required": [
              "marker",
              "chunkId"
            ],
            "additionalProperties": false
          }
        },
        "answerModel": {
          "type": "string"
        }
      },
      "required": [
        "answer"
      ]
    },
    "RagCitationSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "marker": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chunkId": {
          "type": "string"
        }
      },
      "required": [
        "marker",
        "chunkId"
      ],
      "additionalProperties": false
    },
    "RagDetailSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "DESCRITIVO",
            "RAPIDO"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "marker": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "chunkId": {
                "type": "string"
              }
            },
            "required": [
              "marker",
              "chunkId"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunkId": {
                "type": "string"
              },
              "documentId": {
                "type": "string"
              },
              "fileName": {
                "type": "string"
              },
              "chunkIndex": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "score": {
                "type": "number"
              },
              "embeddingStamp": {
                "type": "string"
              }
            },
            "required": [
              "chunkId",
              "documentId",
              "fileName",
              "chunkIndex",
              "score",
              "embeddingStamp"
            ],
            "additionalProperties": false
          }
        },
        "answerModel": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "citations",
        "sources"
      ],
      "additionalProperties": false
    },
    "RagModeSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "enum": [
        "DESCRITIVO",
        "RAPIDO"
      ]
    },
    "RagTechnicalSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "chunkId": {
          "type": "string"
        },
        "documentId": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "chunkIndex": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "score": {
          "type": "number"
        },
        "embeddingStamp": {
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "documentId",
        "fileName",
        "chunkIndex",
        "score",
        "embeddingStamp"
      ],
      "additionalProperties": false
    }
  }
}

{
  "SectorKitDto.ts": {
    "CanonicalAccountSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nature": {
          "type": "string",
          "enum": [
            "Asset",
            "Liability",
            "Equity",
            "Revenue",
            "Expense"
          ]
        },
        "acceptsEntries": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "name",
        "nature",
        "acceptsEntries"
      ],
      "additionalProperties": false
    },
    "SectorKitV1Schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "kitKey": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]+$"
        },
        "kitVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "changelog": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "chartExtension": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "nature": {
                "type": "string",
                "enum": [
                  "Asset",
                  "Liability",
                  "Equity",
                  "Revenue",
                  "Expense"
                ]
              },
              "acceptsEntries": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "name",
              "nature",
              "acceptsEntries"
            ],
            "additionalProperties": false
          }
        },
        "binding": {
          "type": "object",
          "properties": {
            "sectorKey": {
              "type": "string",
              "minLength": 1
            },
            "bindingVersion": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "compiledAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
            },
            "compiledFromHash": {
              "type": "string",
              "minLength": 1
            },
            "eventBindings": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "eventKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "archetypeKey": {
                    "type": "string",
                    "enum": [
                      "revenue_recognition",
                      "settlement",
                      "reversal",
                      "performance_liability",
                      "cogs",
                      "subledger_command",
                      "performance_liability_release"
                    ]
                  },
                  "fieldSlots": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "slotName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "sourceField": {
                          "type": "string",
                          "minLength": 1
                        },
                        "transform": {
                          "default": "identity",
                          "type": "string",
                          "enum": [
                            "cents_from_reais",
                            "identity"
                          ]
                        }
                      },
                      "required": [
                        "slotName",
                        "sourceField"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "roleSlots": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "minLength": 1
                        },
                        "accountCode": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "role",
                        "accountCode"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "descriptionTemplate": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "eventKey",
                  "archetypeKey",
                  "fieldSlots",
                  "roleSlots"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "sectorKey",
            "bindingVersion",
            "compiledAt",
            "compiledFromHash",
            "eventBindings"
          ],
          "additionalProperties": false
        },
        "operationalSchema": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "roleDefaults": {
          "default": {
            "scopeSettings": {},
            "fiscalProfile": {}
          },
          "type": "object",
          "properties": {
            "scopeSettings": {
              "default": {},
              "type": "object",
              "properties": {
                "bankChargeExpenseAccountCode": {
                  "type": "string"
                },
                "bankChargeIncomeAccountCode": {
                  "type": "string"
                },
                "depreciationExpenseAccountCode": {
                  "type": "string"
                },
                "disposalGainAccountCode": {
                  "type": "string"
                },
                "disposalLossAccountCode": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "fiscalProfile": {
              "default": {},
              "type": "object",
              "properties": {
                "icmsRecuperavelAccountCode": {
                  "type": "string"
                },
                "pisCofinsRecuperavelAccountCode": {
                  "type": "string"
                },
                "insumoExpenseAccountCode": {
                  "type": "string"
                },
                "irpjDespesaAccountCode": {
                  "type": "string"
                },
                "csllDespesaAccountCode": {
                  "type": "string"
                },
                "irpjRecolherAccountCode": {
                  "type": "string"
                },
                "csllRecolherAccountCode": {
                  "type": "string"
                },
                "pisDespesaAccountCode": {
                  "type": "string"
                },
                "cofinsDespesaAccountCode": {
                  "type": "string"
                },
                "pisRecolherAccountCode": {
                  "type": "string"
                },
                "cofinsRecolherAccountCode": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "serviceFiscalDefaults": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serviceRef": {
                "type": "string",
                "minLength": 1
              },
              "cTribNac": {
                "type": "string",
                "pattern": "^\\d{6}$"
              },
              "cNBS": {
                "type": "string",
                "pattern": "^\\d{9}$"
              },
              "cIndOp": {
                "default": "030101",
                "type": "string",
                "pattern": "^\\d{6}$"
              }
            },
            "required": [
              "serviceRef",
              "cTribNac"
            ],
            "additionalProperties": false
          }
        },
        "referential": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regime": {
                "type": "string",
                "enum": [
                  "MEI",
                  "SIMPLES",
                  "PRESUMIDO",
                  "REAL"
                ]
              },
              "mappingVersion": {
                "type": "string",
                "pattern": "^\\d{4}$"
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "accountCode": {
                      "type": "string"
                    },
                    "referentialCode": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "accountCode",
                    "referentialCode",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "regime",
              "mappingVersion",
              "entries"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kitKey",
        "kitVersion",
        "label",
        "changelog",
        "chartExtension",
        "binding",
        "operationalSchema"
      ],
      "additionalProperties": false
    }
  }
}

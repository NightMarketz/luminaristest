                      "ALWAYS",
                      "IF_AGGREGATE_MATCH"
                    ]
                  },
                  "errorMessage": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "targetTable"
                ]
              }
            },
            "compositeUnique": {
              "type": "array",

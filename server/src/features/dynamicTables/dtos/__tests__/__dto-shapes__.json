                    "type": "object",
                    "properties": {
                      "minLength": {
                        "type": "number"
                      },
                      "maxLength": {
                        "type": "number"
                      },
                      "minValue": {
                        "type": "number"
                      },
                      "maxValue": {
                        "type": "number"
                      }
                    }
                  },
                  "relation": {
                    "type": "object",
                    "properties": {
                      "targetTable": {
                        "type": "string"
                      },
                      "allowMultiple": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "targetTable"
                    ]
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "email",
                      "phone",
                      "cpf",
                      "cnpj",
                      "url",
                      "custom"
                    ]
                  },
                  "numberFormat": {
                    "type": "string",
                    "enum": [
                      "currency",
                      "percentage",
                      "integer",
                      "decimal"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "regex": {
                    "type": "string"
                  },
                  "hidden": {
                    "type": "boolean"
                  },
                  "readOnly": {
                    "type": "boolean"
                  },
                  "searchable": {
                    "type": "boolean"
                  },
                  "requiredIf": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          "eq",
                          "neq",
                          "in"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {

                      "CASCADE",
                      "RESTRICT_IF_AGGREGATE",
                      "IGNORE"
                    ]
                  },
                  "targetTable": {
                    "type": "string"
                  },
                  "aggregate": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "operator": {
                        "type": "string",
                        "enum": [
                          "gt",
                          "lt",
                          "eq",
                          "neq"
                        ]
                      },
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "field",
                      "operator",
                      "value"
                    ]
                  },
                  "cascadeCondition": {
                    "type": "string",

                        "type": "string",
                        "enum": [
                          "eq",
                          "in"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "op",
                      "value"
                    ]
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "all"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "errorMessage": {
                    "type": "string"
                  }
                },
                "required": [
                  "condition",
                  "scope"
                ]
              }
            },
            "compare": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "left": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "eq",
                      "neq"
                    ]
                  },
                  "right": {
                    "type": "string"
                  },

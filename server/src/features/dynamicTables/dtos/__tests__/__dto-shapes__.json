              }
            },
            "noOverlap": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startField": {
                    "type": "string"
                  },
                  "endField": {
                    "type": "string"
                  },
                  "scopeFields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "errorMessage": {
                    "type": "string"
                  }
                },
                "required": [
                  "startField",
                  "endField"
                ]
              }
            },
            "ui": {
              "type": "object",
              "properties": {
                "presentation": {
                  "type": "string",
                  "enum": [
                    "standalone",
                    "embedded",
                    "system"
                  ]
                }
              }
            }
          },
          "required": [
            "fields"
          ]
        }
      },
      "required": [
        "name",
        "category",
        "schema"
      ]

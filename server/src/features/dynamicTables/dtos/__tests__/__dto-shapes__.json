                                  "type": "boolean"
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "op",
                      "value"
                    ]
                  }
                },
                "required": [
                  "name",
                  "label",
                  "type",
                  "required"
                ]
              }
            },
            "deleteConstraints": {
              "type": "array",

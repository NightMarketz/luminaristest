  "AnalyticsQueryDto.ts": {
    "ChartDataQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": {}
    },
    "ChartDetailsQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "dataPointName": {
          "type": "string"
        },
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },

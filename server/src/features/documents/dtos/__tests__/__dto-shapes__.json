{
  "DocumentDto.ts": {
    "CreateDocumentSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "fileType": {
          "type": "string",
          "enum": [
            "PDF",
            "DOCX",
            "XLSX"
          ]
        },
        "fileSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "documentPurpose": {
          "default": "DATA_ANALYSIS",
          "type": "string",
          "enum": [
            "DATA_ANALYSIS",
            "KNOWLEDGE_BASE"
          ]
        }
      },
      "required": [
        "fileName",
        "fileType",
        "fileSize"
      ]
    },
    "GeneratedContextSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "documentType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "entities": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PESSOA",
                  "EMPRESA",
                  "DATA",
                  "VALOR",
                  "IDENTIFICADOR",
                  "OUTRO"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        },
        "userEditedFields": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "summary",
              "documentType",
              "entities"
            ]
          }
        }
      },
      "required": [
        "version",
        "documentType",
        "entities"
      ],
      "additionalProperties": false
    },
    "ListDocumentsQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "SearchDocumentsSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "documentIds": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "SearchDocumentsToolArgsSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limit": {
          "default": 5,
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "UpdateDocumentContextSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "documentPurpose": {
          "type": "string",
          "enum": [
            "DATA_ANALYSIS",
            "KNOWLEDGE_BASE"
          ]
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "documentType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "entities": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "PESSOA",
                  "EMPRESA",
                  "DATA",
                  "VALOR",
                  "IDENTIFICADOR",
                  "OUTRO"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "type",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "protocolo": "v1",
  "$defs": {
    "PareamentoBody": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "codigo": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32
        },
        "nomeDispositivo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "versaoAssinador": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "certificadoDerB64": {
          "type": "string",
          "minLength": 100,
          "maxLength": 20000
        }
      },
      "required": [
        "codigo",
        "nomeDispositivo",
        "versaoAssinador",
        "certificadoDerB64"
      ],
      "additionalProperties": false
    },
    "PareamentoResposta": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "dispositivoId": {
          "type": "string"
        },
        "token": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43
        },
        "unidades": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitId": {
                "type": "string"
              },
              "cnpj": {
                "type": "string",
                "pattern": "^[0-9A-Z]{12}[0-9]{2}$"
              }
            },
            "required": [
              "unitId",
              "cnpj"
            ],
            "additionalProperties": false
          }
        },
        "ambiente": {
          "type": "string",
          "enum": [
            "producao",
            "homologacao"
          ]
        },
        "protocolo": {
          "type": "string",
          "const": "v1"
        }
      },
      "required": [
        "dispositivoId",
        "unidades",
        "ambiente",
        "protocolo"
      ],
      "additionalProperties": false
    }
  }
}

{
  "ChatInterviewDto.ts": {
    "ChatInterviewSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "stage": {
          "default": "GREETING",
          "type": "string"
        },
        "messages": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "sender": {
                "type": "string",
                "enum": [
                  "user",
                  "ai"
                ]
              },
              "content": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "presetKey": {
          "type": "string"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "choice": {
          "type": "string",
          "enum": [
            "create",
            "customize"
          ]
        },
        "modules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "CRM-0",
                  "CRM-1",
                  "CRM-2A",
                  "CRM-2B",
                  "CRM-3"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "CRM-2"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "InterviewMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        "sender": {
          "type": "string",
          "enum": [
            "user",
            "ai"
          ]
        },
        "content": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "CustomizeFields.dto.ts": {
    "CustomizeFieldsDto": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "message"
            },
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "tableKey": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "kind",
            "sessionId",
            "tableKey",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "decision"
            },
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "tableKey": {
              "type": "string",
              "minLength": 1
            },
            "proposalId": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "type": "string",
              "enum": [
                "apply",
                "discard"
              ]
            },
            "acknowledgeSensitive": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "kind",
            "sessionId",
            "tableKey",
            "proposalId",
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manual"
            },
            "sessionId": {
              "type": "string",
              "minLength": 1
            },
            "tableKey": {
              "type": "string",
              "minLength": 1
            },
            "changes": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "add"
                      },
                      "field": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "string",
                              "number",
                              "boolean",
                              "date",
                              "datetime"
                            ]
                          },
                          "format": {
                            "type": "string",
                            "enum": [
                              "email",
                              "phone"
                            ]
                          },
                          "required": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "name",
                          "label",
                          "type",
                          "required"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "action",
                      "field"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "setHidden"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hidden": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "action",
                      "name",
                      "hidden"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "acknowledgeSensitive": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "kind",
            "sessionId",
            "tableKey",
            "changes"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "CustomCreationDraft.dto.ts": {
    "CustomCreationDraftSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "custom"
        },
        "presetKey": {
          "type": "string",
          "minLength": 1
        },
        "removedTables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "addedFields": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {}
          }
        },
        "addedTables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "fields": {
                "minItems": 1,
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "key",
              "name",
              "fields"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mode",
        "presetKey",
        "removedTables",
        "addedFields",
        "addedTables"
      ],
      "additionalProperties": false
    }
  },
  "InterviewModules.dto.ts": {
    "InterviewModulesSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "modules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "CRM-0",
                  "CRM-1",
                  "CRM-2A",
                  "CRM-2B",
                  "CRM-3"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "CRM-2"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "sessionId",
        "modules"
      ],
      "additionalProperties": false
    }
  }
}

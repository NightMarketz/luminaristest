                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "slotName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceField": {
                      "type": "string",
                      "minLength": 1
                    },
                    "transform": {
                      "default": "identity",
                      "type": "string",
                      "enum": [
                        "cents_from_reais",
                        "identity"
                      ]
                    }
                  },

                    "slotName",
                    "sourceField"
                  ],
                  "additionalProperties": false
                }
              },
              "roleSlots": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "minLength": 1
                    },
                    "accountCode": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "role",
                    "accountCode"
                  ],
                  "additionalProperties": false
                }
              },
              "descriptionTemplate": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "eventKey",
              "archetypeKey",
              "fieldSlots",
              "roleSlots"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sectorKey",
        "bindingVersion",
        "compiledAt",
        "compiledFromHash",
        "eventBindings"
      ],
      "additionalProperties": false
    }

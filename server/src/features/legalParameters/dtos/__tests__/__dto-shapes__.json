{
  "LegalParameterDto.ts": {
    "ProposeLegalParameterSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tabela": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "chave": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "discriminador": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "valorInt": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "valorTexto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "valorJson": {},
        "fonte": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fonteUrl": {
          "type": "string",
          "format": "uri"
        },
        "fonteSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{12,64}$"
        },
        "vigenteDesde": {
          "type": "string"
        },
        "vigenteAte": {
          "type": "string"
        },
        "supersedesId": {
          "type": "string",
          "minLength": 1
        },
        "motivo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "tabela",
        "chave",
        "fonte",
        "vigenteDesde",
        "motivo"
      ],
      "additionalProperties": false
    },
    "ListLegalParametersQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tabela": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "PUBLISHED",
            "REVOKED"
          ]
        }
      },
      "additionalProperties": false
    },
    "ListRecalcJobsQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "DONE"
          ]
        },
        "legalParameterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "VigenteLegalParameterQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tabela": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "chave": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "data": {
          "type": "string"
        },
        "discriminador": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "tabela",
        "chave",
        "data"
      ],
      "additionalProperties": false
    }
  }
}

          "pattern": "^[a-zA-Z_][a-zA-Z0-9_\\s-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "TEXT",
            "NUMBER",
            "CURRENCY",
            "PERCENTAGE",
            "DATE"
          ]
        }
      },
      "required": [
        "name",
        "type"
      ]

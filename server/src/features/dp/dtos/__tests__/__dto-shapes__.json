        "nome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "minutosSemanais": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10080
        },
        "tipoJornada": {
          "type": "string",
          "enum": [
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "9"
          ]
        },
        "descricao": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 999
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "unitId",
        "nome",
        "minutosSemanais",
        "tipoJornada"
      ],
      "additionalProperties": false
    },
    "CreateLotacaoSchema": {

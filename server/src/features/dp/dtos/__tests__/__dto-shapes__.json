{
  "DpModuleDto.ts": {
    "AtivarModuloSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "moduleKey": {
          "type": "string",
          "enum": [
            "DP-PONTO",
            "DP-PAG",
            "DP-BEN",
            "DP-ADM",
            "DP-APP",
            "DP-DES",
            "DP-GED",
            "DP-CAT",
            "DP-BI"
          ]
        },
        "competenciaInicio": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "motivo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "required": [
        "unitId",
        "moduleKey",
        "competenciaInicio",
        "motivo"
      ],
      "additionalProperties": false
    },
    "DpIdParamSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][^\\s-]{8,}$"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "DpScopeQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "unitId"
      ],
      "additionalProperties": false
    },
    "EncerrarModuloSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "competenciaFim": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "motivo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "required": [
        "unitId",
        "competenciaFim",
        "motivo"
      ],
      "additionalProperties": false
    }
  },
  "DpCadastrosDto.ts": {
    "CreateCargoSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "nome": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "cbo": {
          "type": "string",
          "pattern": "^\\d{6}$"
        }
      },
      "required": [
        "unitId",
        "nome",
        "cbo"
      ],
      "additionalProperties": false
    },
    "CreateConvencaoParametroSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1
        },
        "chave": {
          "type": "string",
          "enum": [
            "PISO_SALARIAL_CENTS"
          ]
        },
        "discriminador": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][^\\s-]{8,}$"
        },
        "valorInt": {},
        "clausula": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "vigenteDesde": {
          "type": "string"
        },
        "vigenteAte": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "unitId",
        "chave",
        "discriminador",
        "valorInt",
        "clausula",
        "vigenteDesde"
      ],
      "additionalProperties": false
    },
    "CreateConvencaoSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {

        },
        "competenciaFim": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "motivo": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "required": [
        "unitId",
        "competenciaFim",
        "motivo"
      ],
      "additionalProperties": false
    }
  },

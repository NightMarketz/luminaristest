{
  "ChatMessageDto.ts": {
    "ListChatMessagesQuerySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageSize": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "instanceId"
      ]
    },
    "ChatMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "chatInstanceId": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "createdAt": {},
        "updatedAt": {},
        "promptTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "completionTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "ragDetail": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "DESCRITIVO",
                    "RAPIDO"
                  ]
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "marker": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "chunkId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "marker",
                      "chunkId"
                    ],
                    "additionalProperties": false
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chunkId": {
                        "type": "string"
                      },
                      "documentId": {
                        "type": "string"
                      },
                      "fileName": {
                        "type": "string"
                      },
                      "chunkIndex": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "score": {
                        "type": "number"
                      },
                      "embeddingStamp": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "chunkId",
                      "documentId",
                      "fileName",
                      "chunkIndex",
                      "score",
                      "embeddingStamp"
                    ],
                    "additionalProperties": false
                  }
                },
                "answerModel": {
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "citations",
                "sources"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "content",
        "role",
        "chatInstanceId",
        "createdAt",
        "updatedAt",
        "promptTokens",
        "completionTokens",
        "model",
        "ragDetail"
      ]
    },
    "CreateChatMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "chatInstanceId": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "documentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "content",
        "chatInstanceId"
      ]
    },
    "UpdateChatMessageSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "chatInstanceId": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "documentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ChatMessageSummarySchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "cuid",
          "pattern": "^[cC][0-9a-z]{6,}$"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "createdAt": {},
        "ragDetail": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "DESCRITIVO",
                    "RAPIDO"
                  ]
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "marker": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "chunkId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "marker",
                      "chunkId"
                    ],
                    "additionalProperties": false
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "chunkId": {
                        "type": "string"
                      },
                      "documentId": {
                        "type": "string"
                      },
                      "fileName": {
                        "type": "string"
                      },
                      "chunkIndex": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "score": {
                        "type": "number"
                      },
                      "embeddingStamp": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "chunkId",
                      "documentId",
                      "fileName",
                      "chunkIndex",
                      "score",
                      "embeddingStamp"
                    ],
                    "additionalProperties": false
                  }
                },
                "answerModel": {
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "citations",
                "sources"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "content",
        "role",
        "createdAt",
        "ragDetail"
      ]
    }
  }
}
